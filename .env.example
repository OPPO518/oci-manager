# 复制为 .env 后填入真实值：cp .env.example .env
# 生成密钥：openssl rand -hex 32
# 该密钥用于加密 OCI API 私钥，录入账号后不可再更改，否则已存账号将无法解密
OCI_MANAGER_ENCRYPTION_KEY=

# 可选：覆盖预构建镜像地址（默认 ghcr.io/oppo518/oci-manager:latest）
# OCI_MANAGER_IMAGE=ghcr.io/oppo518/oci-manager:latest

# 可选：宿主机端口映射（默认 HTTP 8080、HTTPS 443）
# OCI_MANAGER_PORT=8080
# OCI_MANAGER_HTTPS_PORT=443
